# ALETHEIA environment template (copy to .env.local or load via direnv)
ALETHEIA_RUNTIME_PROFILE=zbook-single

# --- Local product defaults (single laptop) ---
# Typical LM Studio default endpoint.
ALETHEIA_LLM_BASE_URL=http://127.0.0.1:1234
# Set to a loaded chat model id for LM Studio/Ollama.
ALETHEIA_LLM_MODEL=

# Typical local embeddings endpoint (LM Studio or Ollama OpenAI-compatible /v1/embeddings).
ALETHEIA_EMBED_BASE_URL=http://127.0.0.1:1234
ALETHEIA_EMBED_MODEL=

# Optional API keys for OpenAI-compatible proxies
ALETHEIA_LLM_API_KEY=
ALETHEIA_EMBED_API_KEY=

# --- Retrieval/Search ---
ALETHEIA_WEB_SEARCH_PROVIDER=auto
ALETHEIA_WEB_SEARCH_CHAIN=brave,duckduckgo
ALETHEIA_ENABLE_CRAWL4AI_FALLBACK=1

# Keep Google/Scholar disabled until keys are present.
ALETHEIA_WEB_PROVIDER_BUDGET_PER_RUN=brave:3,duckduckgo:2,google:0,serpapi_google_scholar:0
ALETHEIA_WEB_RATE_LIMIT_PER_MIN=brave:30,duckduckgo:40,google:0,serpapi_google_scholar:0
ALETHEIA_ENABLE_DEEP_RESEARCH=0

# --- Optional external keys ---
BRAVE_SEARCH_API_KEY=
FRED_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=
CENSUS_API_KEY=

# --- Optional personal homelab LAN references ---
ALETHEIA_MINI_LLM_BASE_URL=http://192.168.86.141:8080
ALETHEIA_DYNAMO_LMSTUDIO_BASE_URL=http://192.168.86.143:1234
ALETHEIA_DYNAMO_OLLAMA_BASE_URL=http://192.168.86.143:11434
